<mxfile host="app.diagrams.net">
  <diagram id="d1" name="Vimeo Indonesia Backup Plan">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1150">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Vimeo backup for Indonesia&lt;/b&gt; — R2 copy, used only when Vimeo is blocked" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Phase backdrops -->
        <mxCell id="bgCopy" value="1. Backup copy (automatic)" style="rounded=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="1360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="bgSwitch" value="2. Who gets the backup (everyone else unchanged)" style="rounded=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=2;fillColor=none;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="1360" height="530" as="geometry" />
        </mxCell>
        <mxCell id="bgAnalytics" value="3. Analytics" style="rounded=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;fontStyle=2;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="790" width="1000" height="300" as="geometry" />
        </mxCell>

        <!-- Row 1: copy pipeline -->
        <mxCell id="team" value="Team uploads &amp; tags&#10;on Vimeo (as today)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vimeo" value="&lt;b&gt;Vimeo&lt;/b&gt;&#10;(Studio plan)&#10;5,017 videos / 645 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="115" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="copyjob" value="&lt;b&gt;Copy job&lt;/b&gt; (Cloudflare Worker)&#10;checks every 10 min,&#10;copies last 3 months at 720p&#10;(older: copy on demand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="115" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Cloudflare R2&lt;/b&gt;&#10;backup videos + captions&#10;~9 GB (last 3 months)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="upload" style="endArrow=block;html=1;" edge="1" parent="1" source="team" target="vimeo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="new video?" style="endArrow=block;html=1;" edge="1" parent="1" source="vimeo" target="copyjob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="save copy" style="endArrow=block;html=1;" edge="1" parent="1" source="copyjob" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Row 2: entry points -->
        <mxCell id="dashViewer" value="&lt;b&gt;Dashboard&lt;/b&gt; viewer / TV&#10;(Vercel)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="110" y="290" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="webReader" value="&lt;b&gt;Website&lt;/b&gt; reader&#10;(ABR, SBR... on Drupal)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1050" y="290" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dashLogic" value="Dashboard video players&#10;(switch code in this repo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="webWorker" value="&lt;b&gt;Cloudflare Worker&lt;/b&gt; on site&#10;(article pages only,&#10;no Drupal access needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1050" y="385" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="decDash" value="In Indonesia&#10;OR Vimeo&#10;fails to load?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="decWeb" value="In Indonesia&#10;OR Vimeo&#10;fails to load?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1070" y="490" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="vimeoDash" value="Normal &lt;b&gt;Vimeo player&lt;/b&gt;&#10;(same as today)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vimeoWeb" value="Normal &lt;b&gt;Vimeo player&lt;/b&gt;&#10;(same as today)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1180" y="680" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="backup" value="&lt;b&gt;Backup player page&lt;/b&gt;&#10;video.charltonmedia.com/embed/&amp;lt;vimeo id&amp;gt;&#10;same video, captions, 720p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="500" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="onDemand" value="&lt;b&gt;Copy on demand&lt;/b&gt;&#10;video not backed up yet?&#10;stream from Vimeo now + save to R2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Edges: switching -->
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="dashViewer" target="dashLogic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="dashLogic" target="decDash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;" edge="1" parent="1" source="webReader" target="webWorker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="endArrow=block;html=1;" edge="1" parent="1" source="webWorker" target="decWeb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e14" value="No" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decDash" target="vimeoDash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="Yes" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="decDash" target="backup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="No" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decWeb" target="vimeoWeb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="Yes" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="decWeb" target="backup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e18" value="plays video from R2&#10;(free delivery)" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;curved=1;strokeColor=#82b366;exitX=0.25;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="r2" target="backup">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="250" />
              <mxPoint x="810" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" value="missing?" style="endArrow=block;html=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="backup" target="onDemand">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="fetch" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="onDemand" target="vimeo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="save" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="onDemand" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Analytics -->
        <mxCell id="ga4" value="&lt;b&gt;GA4 events&lt;/b&gt; on each website&#10;video start / 25-50-75% / complete&#10;video_source = backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="160" y="850" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="counter" value="&lt;b&gt;Backup play counter&lt;/b&gt; (Cloudflare)&#10;country, ISP, video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="600" y="850" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="combined" value="Dashboard shows&#10;&lt;b&gt;Vimeo plays + backup plays&lt;/b&gt;&#10;+ blocked-viewer report" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="980" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="events" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="backup" target="ga4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e31" value="count play" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="backup" target="counter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32" style="endArrow=block;html=1;" edge="1" parent="1" source="counter" target="combined">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cost note -->
        <mxCell id="cost" value="&lt;b&gt;Est. cost / month&lt;/b&gt;&lt;br&gt;R2 storage (~9 GB + existing 4 GB): ~$0.05&lt;br&gt;Workers: Free plan to start ($5 if we outgrow it)&lt;br&gt;Delivery, checks, on-demand copies: $0&lt;br&gt;&lt;b&gt;Total: ~$0–5&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Needed first&lt;/b&gt;&lt;br&gt;1. New Vimeo token (video_files)&lt;br&gt;2. Cloudflare access (R2 + Worker)&lt;br&gt;3. Tester in Indonesia (TV + Telkomsel)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1050" y="800" width="320" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
